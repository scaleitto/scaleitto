# MySQL connection (create the database and user in cPanel → MySQL Databases)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
DATABASE_POOL_SIZE=5

# Public URL of the platform
APP_URL="https://scaleitto.com"
# Main platform domain
ROOT_DOMAIN="scaleitto.com"
# true → shops are served at <slug>.scaleitto.com (needs wildcard DNS + SSL).
# false → shops are served at scaleitto.com/store/<slug> (works everywhere).
SHOP_SUBDOMAINS=false

# Email of the platform owner: the account registered with it gets the admin panel
PLATFORM_ADMIN_EMAIL="you@example.com"

# Algeria time, so "today" and "this month" stats are correct
TZ="Africa/Algiers"

# AI features (landing page generator). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional: model to use (default gpt-5-mini)
# OPENAI_MODEL="gpt-5-mini"
